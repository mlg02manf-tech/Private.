
const int Led1 = 10;
const int Led2 = 9;
const int Led3 = 8;
const int Led4 = 7;
const int Led5 = 6;
const int Led6 = 5;
const int Led7 = 4;
const int Led8 = 3;
const int Led9 = 2;
const int Buzzer = 11;

const int ledPins[] = {
  Led1, Led2, Led3, Led4, Led5,
  Led6, Led7, Led8, Led9
};

void setup() {
  for (int i = 0; i < 9; i++) {
    pinMode(ledPins[i], OUTPUT);
  }

  pinMode(Buzzer, OUTPUT);
  offAll();
}

void loop() {
  offAll();

  dIntro();
  delay(100);

  dChar();
  delay(2000);

  dOutro();
  delay(10);

  xChar();
  delay(2000);

  Xtransition();
  delay(1000);

  qChar();
  delay(1000);

  cChar();
  delay(1000);

  ddChar();
  delay(1000);
}

// Turn off all LEDs
void offAll() {
  for (int i = 0; i < 9; i++) {
    digitalWrite(ledPins[i], LOW);
  }
}

// LED and buzzer helper
void lightNote(int led, int frequency, int duration) {
  digitalWrite(led, HIGH);
  tone(Buzzer, frequency);
  delay(duration);
}

void silence(int duration) {
  noTone(Buzzer);
  delay(duration);
}

// Buzzer sweep
void flashBang() {
  for (int frequency = 200; frequency <= 2000; frequency += 100) {
    tone(Buzzer, frequency);
    delay(5);
  }

  for (int frequency = 2000; frequency >= 200; frequency -= 150) {
    tone(Buzzer, frequency);
    delay(10);
  }

  noTone(Buzzer);
  delay(100);
}

// X transition
void Xtransition() {
  for (int i = 0; i < 4; i++) {
    digitalWrite(Led1, HIGH);
    digitalWrite(Led2, LOW);
    digitalWrite(Led3, HIGH);
    digitalWrite(Led4, LOW);
    digitalWrite(Led5, HIGH);
    digitalWrite(Led6, LOW);
    digitalWrite(Led7, HIGH);
    digitalWrite(Led8, LOW);
    digitalWrite(Led9, HIGH);

    tone(Buzzer, 1000);
    delay(200);

    digitalWrite(Led1, LOW);
    digitalWrite(Led2, HIGH);
    digitalWrite(Led3, LOW);
    digitalWrite(Led4, HIGH);
    digitalWrite(Led5, HIGH);
    digitalWrite(Led6, HIGH);
    digitalWrite(Led7, LOW);
    digitalWrite(Led8, HIGH);
    digitalWrite(Led9, LOW);

    tone(Buzzer, 500);
    delay(200);
  }

  digitalWrite(Led1, HIGH);
  digitalWrite(Led2, LOW);
  digitalWrite(Led3, HIGH);
  digitalWrite(Led4, LOW);
  digitalWrite(Led5, LOW);
  digitalWrite(Led6, LOW);
  digitalWrite(Led7, HIGH);
  digitalWrite(Led8, LOW);
  digitalWrite(Led9, HIGH);

  tone(Buzzer, 1500);
  delay(200);

  offAll();
  noTone(Buzzer);
}

