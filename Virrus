// Intro sequence
void dIntro() {
  Race1();
  delay(10);

  Race2();
  delay(100);

  offAll();
  delay(100);

  digitalWrite(Led3, HIGH);
  digitalWrite(Led7, HIGH);
  tone(Buzzer, 1000);
  delay(100);

  noTone(Buzzer);
  delay(200);

  digitalWrite(Led8, HIGH);
  digitalWrite(Led4, HIGH);
  digitalWrite(Led2, HIGH);
  digitalWrite(Led6, HIGH);
  tone(Buzzer, 1000);
  delay(100);

  noTone(Buzzer);
  delay(200);

  offAll();
}

// Outro spinning effect
void dOutro() {
  for (int spin = 0; spin < 5; spin++) {
    digitalWrite(Led1, HIGH);
    digitalWrite(Led2, LOW);
    digitalWrite(Led3, LOW);
    digitalWrite(Led4, LOW);
    digitalWrite(Led5, HIGH);
    digitalWrite(Led6, LOW);
    digitalWrite(Led7, LOW);
    digitalWrite(Led8, LOW);
    digitalWrite(Led9, HIGH);

    tone(Buzzer, 150);
    delay(100);

    digitalWrite(Led2, HIGH);
    digitalWrite(Led8, HIGH);
    digitalWrite(Led1, LOW);
    digitalWrite(Led9, LOW);

    tone(Buzzer, 100);
    delay(100);

    digitalWrite(Led7, HIGH);
    digitalWrite(Led3, HIGH);
    digitalWrite(Led2, LOW);
    digitalWrite(Led8, LOW);

    tone(Buzzer, 50);
    delay(100);

    digitalWrite(Led4, HIGH);
    digitalWrite(Led6, HIGH);
    digitalWrite(Led7, LOW);
    digitalWrite(Led3, LOW);

    tone(Buzzer, 100);
    delay(100);
  }

  digitalWrite(Led1, HIGH);
  digitalWrite(Led9, HIGH);
  digitalWrite(Led6, LOW);
  digitalWrite(Led4, LOW);

  tone(Buzzer, 150);
  delay(100);

  noTone(Buzzer);
  delay(150);

  digitalWrite(Led2, HIGH);
  digitalWrite(Led8, HIGH);
  digitalWrite(Led1, LOW);
  digitalWrite(Led9, LOW);

  tone(Buzzer, 1000);
  delay(150);

  noTone(Buzzer);
  delay(100);
}

// X character effect
void xChar() {
  flow1();
  flow2();
  flow3();

  offAll();
  delay(100);

  digitalWrite(Led1, HIGH);
  digitalWrite(Led5, HIGH);
  digitalWrite(Led9, HIGH);

  tone(Buzzer, 1000);
  delay(100);

  noTone(Buzzer);
  offAll();
  delay(200);

  digitalWrite(Led3, HIGH);
  digitalWrite(Led5, HIGH);
  digitalWrite(Led7, HIGH);

  tone(Buzzer, 1000);
  delay(100);

  noTone(Buzzer);
  offAll();
  delay(100);

  digitalWrite(Led1, HIGH);
  digitalWrite(Led3, HIGH);
  digitalWrite(Led5, HIGH);
  digitalWrite(Led7, HIGH);
  digitalWrite(Led9, HIGH);

  flashBang();
}

// Diagonal character
void dChar() {
  digitalWrite(Led1, HIGH);
  digitalWrite(Led5, HIGH);
  digitalWrite(Led9, HIGH);

  flashBang();
}

// Square: intro, melody, flash, outro
void qChar() {
  offAll();

  int square[] = {
    Led1, Led2, Led3, Led6,
    Led9, Led8, Led7, Led4
  };

  int notes[] = {
    262, 330, 392, 440,
    523, 440, 392, 330
  };

  // INTRO: corner flashes
  for (int i = 0; i < 3; i++) {
    digitalWrite(Led1, HIGH);
    digitalWrite(Led3, HIGH);
    digitalWrite(Led7, HIGH);
    digitalWrite(Led9, HIGH);

    tone(Buzzer, 700 + i * 150);
    delay(100);

    offAll();
    delay(70);
  }

  // MAIN: build square
  for (int i = 0; i < 8; i++) {
    lightNote(square[i], notes[i], 120);
  }

  silence(150);

  // FLASH: blink square
  for (int i = 0; i < 4; i++) {
    for (int j = 0; j < 8; j++) {
      digitalWrite(square[j], LOW);
    }

    tone(Buzzer, 900);
    delay(100);

    for (int j = 0; j < 8; j++) {
      digitalWrite(square[j], HIGH);
    }

    tone(Buzzer, 1200);
    delay(100);
  }

  // OUTRO: chase around square
  for (int i = 7; i >= 0; i--) {
    digitalWrite(square[i], LOW);
    tone(Buzzer, 500 + i * 80);
    delay(70);
  }

  // Restore square
  for (int i = 0; i < 8; i++) {
    digitalWrite(square[i], HIGH);
  }

  noTone(Buzzer);
}

// Corners: intro, alternating flashes, outro
void cChar() {
  offAll();

  int corners[] = {Led1, Led3, Led7, Led9};
  int notes[] = {523, 659, 784, 1047};

  // INTRO: corners activate one by one
  for (int i = 0; i < 4; i++) {
    lightNote(corners[i], notes[i], 120);
  }

  silence(150);

  // MAIN: alternate opposite corners
  for (int i = 0; i < 4; i++) {
    digitalWrite(Led1, HIGH);
    digitalWrite(Led9, HIGH);
    digitalWrite(Led3, LOW);
    digitalWrite(Led7, LOW);

    tone(Buzzer, 700 + i * 100);
    delay(120);

    digitalWrite(Led1, LOW);
    digitalWrite(Led9, LOW);
    digitalWrite(Led3, HIGH);
    digitalWrite(Led7, HIGH);

    tone(Buzzer, 1000 - i * 100);
    delay(120);
  }

  // FLASH: all corners
  for (int i = 0; i < 4; i++) {
    for (int j = 0; j < 4; j++) {
      digitalWrite(corners[j], LOW);
    }

    tone(Buzzer, 1200);
    delay(80);

    for (int j = 0; j < 4; j++) {
      digitalWrite(corners[j], HIGH);
    }

    tone(Buzzer, 800);
    delay(80);
  }

  // OUTRO: corners turn off in reverse
  for (int i = 3; i >= 0; i--) {
    digitalWrite(corners[i], LOW);
    tone(Buzzer, 600 + i * 150);
    delay(100);
  }

  // Restore corners
  for (int i = 0; i < 4; i++) {
    digitalWrite(corners[i], HIGH);
  }

  noTone(Buzzer);
}

// Diamond: intro, rhythmic chase, flash, outro
void ddChar() {
  offAll();

  int diamond[] = {Led2, Led4, Led6, Led8};
  int notes[] = {392, 523, 659, 784};

  // INTRO: diamond points appear
  for (int i = 0; i < 4; i++) {
    lightNote(diamond[i], notes[i], 150);
  }

  silence(150);

  // MAIN: alternate diamond points
  for (int i = 0; i < 4; i++) {
    digitalWrite(Led2, HIGH);
    digitalWrite(Led6, HIGH);
    digitalWrite(Led4, LOW);
    digitalWrite(Led8, LOW);

    tone(Buzzer, 600 + i * 100);
    delay(130);

    digitalWrite(Led2, LOW);
    digitalWrite(Led6, LOW);
    digitalWrite(Led4, HIGH);
    digitalWrite(Led8, HIGH);

    tone(Buzzer, 900 - i * 100);
    delay(130);
  }

  // FLASH: blink diamond
  for (int i = 0; i < 5; i++) {
    offAll();

    tone(Buzzer, 1000 + i * 100);
    delay(80);

    for (int j = 0; j < 4; j++) {
      digitalWrite(diamond[j], HIGH);
    }

    tone(Buzzer, 700 + i * 100);
    delay(100);
  }

  // OUTRO: points disappear one by one
  for (int i = 3; i >= 0; i--) {
    digitalWrite(diamond[i], LOW);
    tone(Buzzer, 500 + i * 120);
    delay(100);
  }

  // Restore diamond
  for (int i = 0; i < 4; i++) {
    digitalWrite(diamond[i], HIGH);
  }

  noTone(Buzzer);
}
